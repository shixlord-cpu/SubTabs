# Kopieren nach closed-test.env (liegt in .gitignore) — echten Token NUR dort, nie hier eintragen.
# Oder Variablen in der Windows-Umgebung / IDE Run Configuration setzen.

# Marketplace Upload — Token erzeugen (NICHT nachtraeglich einsehbar):
#   https://plugins.jetbrains.com/author/me/tokens
# Einloggen → Generate (New) Token → Scope "Marketplace" → Token sofort kopieren (perm:...)
PUBLISH_TOKEN=

# Plugin Signing (https://plugins.jetbrains.com/docs/intellij/plugin-signing.html)
# PEM-Inhalt als eine Zeile oder Base64 — siehe JetBrains-Doku.
PRIVATE_KEY=
PRIVATE_KEY_PASSWORD=
CERTIFICATE_CHAIN=
