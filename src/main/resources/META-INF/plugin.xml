<idea-plugin>

    <id>com.zayax.component-subtabs</id>

    <name>TabZ</name>

    <vendor>ZaYaX</vendor>



    <description><![CDATA[

        Compact subtabs above the editor for related files (components, configs,

        stack-specific groups, state, models, and more) in IntelliJ-based IDEs.

    ]]></description>



    <depends>com.intellij.modules.platform</depends>
    <depends optional="true">com.intellij.modules.vcs</depends>
    <depends optional="true">JavaScript</depends>



    <extensions defaultExtensionNs="com.intellij">
        <editorTabTitleProvider implementation="de.sasbe.subtabs.ComponentEditorTabTitleProvider"/>
        <editorTabColorProvider implementation="de.sasbe.subtabs.SubtabGroupEditorTabColorProvider"/>
        <fileIconProvider implementation="de.sasbe.subtabs.SubtabGroupFileIconProvider" order="first"/>
        <iconProvider implementation="de.sasbe.subtabs.SubtabGroupPsiIconProvider" order="first"/>
        <projectActivity implementation="de.sasbe.subtabs.ComponentSubtabsStartupActivity"/>
        <projectActivity implementation="de.sasbe.subtabs.DemoLintWarmupActivity"/>
        <projectActivity implementation="de.sasbe.subtabs.DemoReplayStartupActivity"/>
        <applicationConfigurable
                parentId="tools"
                instance="de.sasbe.subtabs.SubtabsConfigurable"
                id="de.sasbe.subtabs.settings"
                displayName="TabZ"
                icon="de.sasbe.subtabs.SubtabsIcons.ACTIVE"/>
        <treeStructureProvider implementation="de.sasbe.subtabs.SubtabGroupTreeStructureProvider"/>
    </extensions>



    <actions>
        <action id="SubTabs.SelectPreviousSubtab"
                class="de.sasbe.subtabs.SubtabSelectPreviousAction"
                text="Previous subtab"
                description="Switch to the subtab on the left">
            <keyboard-shortcut keymap="$default" first-keystroke="alt LEFT"/>
        </action>
        <action id="SubTabs.SelectNextSubtab"
                class="de.sasbe.subtabs.SubtabSelectNextAction"
                text="Next subtab"
                description="Switch to the subtab on the right">
            <keyboard-shortcut keymap="$default" first-keystroke="alt RIGHT"/>
        </action>
        <group id="SubTabs.Familia"
                class="de.sasbe.subtabs.SubtabFamiliaActionGroup"
                popup="true"
                text="TabZ">
            <action id="SubTabs.RevealInProjectView"
                    class="de.sasbe.subtabs.SubtabRevealInProjectViewAction"
                    text="Show in Project view"/>
            <separator/>
            <action id="SubTabs.ChangeGroupColor"
                    class="de.sasbe.subtabs.SubtabGroupChangeColorAction"
                    text="Change group color…"/>
            <separator/>
            <action id="SubTabs.ResetGroupColor"
                    class="de.sasbe.subtabs.SubtabGroupResetColorAction"
                    text="Reassign group color"/>
            <separator/>
            <group id="SubTabs.SavedSplittabs"
                    class="de.sasbe.subtabs.SubtabSavedSplittabsActionGroup"
                    popup="true"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>



    <projectListeners>
        <listener class="de.sasbe.subtabs.ComponentSubtabsFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="de.sasbe.subtabs.ComponentSubtabsFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener$Before"/>
        <listener class="de.sasbe.subtabs.SubtabGroupTreeControlListener"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <listener class="de.sasbe.subtabs.DemoReplayFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="de.sasbe.subtabs.PerfFileOpenHarness"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="de.sasbe.subtabs.ComponentSubtabNavigationTargetPopupInstaller"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

</idea-plugin>
