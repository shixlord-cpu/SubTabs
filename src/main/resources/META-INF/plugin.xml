<idea-plugin>

    <id>com.zayax.tabz</id>

    <name>TabZ</name>

    <vendor>ZaYaX</vendor>



    <description><![CDATA[

        Compact subtabs above the editor for related files (components, configs,

        stack-specific groups, state, models, and more) in IntelliJ-based IDEs.

    ]]></description>



    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="com.zayax.tabz-withVcs.xml">com.intellij.modules.vcs</depends>



    <extensions defaultExtensionNs="com.intellij">
        <editorTabTitleProvider implementation="com.zayax.tabz.ComponentEditorTabTitleProvider"/>
        <editorTabColorProvider implementation="com.zayax.tabz.SubtabGroupEditorTabColorProvider"/>
        <fileIconProvider implementation="com.zayax.tabz.SubtabGroupFileIconProvider" order="first"/>
        <iconProvider implementation="com.zayax.tabz.SubtabGroupPsiIconProvider" order="first"/>
        <projectActivity implementation="com.zayax.tabz.ComponentSubtabStartupActivity"/>
        <projectActivity implementation="com.zayax.tabz.DemoLintWarmupActivity"/>
        <projectActivity implementation="com.zayax.tabz.DemoReplayStartupActivity"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.zayax.tabz.TabzConfigurable"
                id="com.zayax.tabz.settings"
                displayName="TabZ"
                icon="com.zayax.tabz.SubtabsIcons.ACTIVE"/>
        <treeStructureProvider implementation="com.zayax.tabz.SubtabGroupTreeStructureProvider"/>
    </extensions>



    <actions>
        <action id="TabZ.SelectPreviousSubtab"
                class="com.zayax.tabz.SubtabSelectPreviousAction"
                text="Previous subtab"
                description="Switch to the subtab on the left">
            <keyboard-shortcut keymap="$default" first-keystroke="alt LEFT"/>
        </action>
        <action id="TabZ.SelectNextSubtab"
                class="com.zayax.tabz.SubtabSelectNextAction"
                text="Next subtab"
                description="Switch to the subtab on the right">
            <keyboard-shortcut keymap="$default" first-keystroke="alt RIGHT"/>
        </action>
        <group id="TabZ.Tabz"
                class="com.zayax.tabz.TabzActionGroup"
                popup="true"
                text="TabZ">
            <action id="TabZ.RevealInProjectView"
                    class="com.zayax.tabz.SubtabRevealInProjectViewAction"
                    text="Show in Project view"/>
            <separator/>
            <action id="TabZ.ChangeGroupColor"
                    class="com.zayax.tabz.SubtabGroupChangeColorAction"
                    text="Change group color…"/>
            <separator/>
            <action id="TabZ.ResetGroupColor"
                    class="com.zayax.tabz.SubtabGroupResetColorAction"
                    text="Reassign group color"/>
            <separator/>
            <group id="TabZ.SavedSplittabs"
                    class="com.zayax.tabz.SubtabSavedSplittabsActionGroup"
                    popup="true"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>



    <projectListeners>
        <listener class="com.zayax.tabz.ComponentSubtabFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="com.zayax.tabz.ComponentSubtabFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener$Before"/>
        <listener class="com.zayax.tabz.SubtabGroupTreeControlListener"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <listener class="com.zayax.tabz.DemoReplayFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

</idea-plugin>
